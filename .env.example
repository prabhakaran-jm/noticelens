# Copy to .env.local only when you use your own Firebase project.
# Leave .env.local absent for local exploration.
# Do not commit credentials, service accounts, App Check debug tokens, or raw private notices.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_APPCHECK_SITE_KEY=
# Ordinary use leaves this empty. A URL parameter or localStorage value cannot enable it.
VITE_NOTICELENS_REAL_CLOUD_DIAGNOSTIC=
