# Copy to .env.local once the app is implemented. Do not commit credentials,
# service accounts, App Check debug tokens, or raw private notices.
# Public Firebase client config can be added once the web starter is created.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_APPCHECK_SITE_KEY=
# Development only. Leave empty. Set to 1 in the environment of a loopback
# diagnostic process. A URL parameter or localStorage value cannot enable it.
VITE_NOTICELENS_REAL_CLOUD_DIAGNOSTIC=
